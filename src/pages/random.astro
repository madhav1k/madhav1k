---
import MainLayout from '../layouts/MainLayout.astro';
import CommandPrompt from '../components/CommandPrompt.astro';
---

<MainLayout title="Random | Madhavik Dogra" description="Projects and links">
  <CommandPrompt command="curl -s https://www.linkedin.com/in/madhav1k" />

  <div class="posts-container">
    <div class="content-wrapper">
      <h2>Projects & Open Source</h2>
      <ul class="project-list">
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/madhav1k/jobtain" target="_blank" rel="noopener" class="project-link">Jobtain</a>
          <span class="project-desc">— Autonomous AI job application agent (LangGraph, Playwright, SQLAlchemy)</span>
        </li>
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/madhav1k/RAG-Agent-with-LLM-as-a-Judge" target="_blank" rel="noopener" class="project-link">RAG Agent with LLM-as-a-Judge</a>
          <span class="project-desc">— Retrieval over arXiv papers with Gemini auto-scoring (FAISS, LangChain, Gradio)</span>
        </li>
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/madhav1k/Traffic" target="_blank" rel="noopener" class="project-link">Traffic Sign Recognition</a>
          <span class="project-desc">— CNN on GTSRB dataset, 5.3% → 97.6% accuracy (TensorFlow, OpenCV)</span>
        </li>
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/madhav1k/Attention" target="_blank" rel="noopener" class="project-link">BERT Attention Visualizer</a>
          <span class="project-desc">— Visualize all 144 attention heads of BERT (Hugging Face Transformers)</span>
        </li>
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/madhav1k/OpenCorpus" target="_blank" rel="noopener" class="project-link">OpenCorpus</a>
          <span class="project-desc">— Multilingual compilation of open-source textual corpora for linguistic research</span>
        </li>
      </ul>

      <h2>Open Source Contributions</h2>
      <ul class="project-list">
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/huggingface/transformers" target="_blank" rel="noopener" class="project-link">Hugging Face Transformers</a>
        </li>
        <li>
          <span class="arrow">→</span>
          <a href="https://github.com/vllm-project/vllm" target="_blank" rel="noopener" class="project-link">vLLM</a>
        </li>
      </ul>
    </div>
  </div>
</MainLayout>

<style>
  .posts-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .content-wrapper {
    padding-left: 20px;
  }

  h2 {
    color: var(--terminal-green);
    font-size: 1.3rem;
    margin: 30px 0 15px;
  }

  h2:first-child {
    margin-top: 10px;
  }

  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-list li {
    display: flex;
    align-items: baseline;
    padding: 6px 0;
    font-size: 0.95em;
    line-height: 1.5;
  }

  .arrow {
    color: var(--terminal-green);
    margin-right: 10px;
    font-weight: bold;
    flex-shrink: 0;
  }

  .project-link {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .project-desc {
    color: var(--text-muted, #9aa5ce);
    margin-left: 5px;
  }
</style>
